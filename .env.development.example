# Shared DEVELOPMENT server template; copy to .env on that installation.
# All example.net domains below are placeholders. Set your real development domains.
# Optional same-checkout profile filename: .env.development
APP_NAME="Sari-sari Store POS"
APP_ENV=development
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.dev.example.net
FRONTEND_URL=https://app.dev.example.net
CORS_ALLOWED_ORIGINS=https://app.dev.example.net,https://admin.dev.example.net
SANCTUM_STATEFUL_DOMAINS=app.dev.example.net,admin.dev.example.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# Fill with a DEVELOPMENT database and restricted user, separate from local/production.
DB_CONNECTION=mysql
DB_URL=
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Use the shared parent of API, owner app, and admin domains for Sanctum SPA cookies.
SESSION_DOMAIN=.dev.example.net
SESSION_COOKIE=sarisari_development_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FREE_PRODUCT_LIMIT=100
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=sarisari_development_cache_

# Log mail on the shared development server until its test mail service is configured.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@dev.example.net
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

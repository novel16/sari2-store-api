# PRODUCTION server template; copy to .env only on that installation.
# All example.com domains below are placeholders. Set your real production domains.
# Optional same-checkout profile filename: .env.production
APP_NAME="Sari-sari Store POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
ADMIN_URL=https://admin.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
SANCTUM_STATEFUL_DOMAINS=app.example.com,admin.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Fill with the PRODUCTION database and restricted user. No local credentials are copied.
DB_CONNECTION=mysql
DB_URL=
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Use the shared parent of API, owner app, and admin domains for Sanctum SPA cookies.
SESSION_DOMAIN=.example.com
SESSION_COOKIE=sarisari_production_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FREE_PRODUCT_LIMIT=100
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=sarisari_production_cache_

# Configure the real SMTP service before enabling password-reset email delivery.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PayMongo Hosted Checkout / QR Ph. See PAYMONGO_SETUP.md. Credentials stay server-side.
# Enable only after setting matching API credentials and this endpoint's signing secret.
PAYMONGO_ENABLED=false
PAYMONGO_MODE=live
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
